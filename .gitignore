# Виртуальное окружение (из нашего прошлого примера)
venv/
env/
ENV/

# Файлы с переменными окружения (секреты — самое важное!)
.env
.env.local
.env.*.local

# Файлы конфигурации с паролями (если такие есть)
*.cnf
secrets.cnf
cnf.py
# Файлы IDE
.vscode/
.idea/
*.swp
*.swo

# Системные файлы
.DS_Store
Thumbs.db

# Логи и временные файлы
*.log
*.tmp
*.cache

# Файлы Python
__pycache__/
*.py[cod]
*.so
.Python